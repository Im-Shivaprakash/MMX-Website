# The deployed URL of the Google Apps Script Web App that writes signup
# submissions into your Google Sheet (ends in /exec). See google-apps-script/
# in this repo for the script to paste in and deploy steps.
# Vite only exposes env vars prefixed with VITE_ to client-side code.
VITE_SHEETS_WEBAPP_URL=your_apps_script_web_app_url_here
